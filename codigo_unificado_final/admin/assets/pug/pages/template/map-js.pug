- var page_Title = 'Map Js';
- var theme_customizer      = true;
- var map_js                = true;
- var sidebar               = true;
- var slick                 = true;
- var header_slider         = true;
- var scrollbar             = true;

doctype html
html(lang='en')
  include ../../components/header-files
  body
    include ../../components/loader
    include ../../components/taptop
    // page-wrapper Start
    #pageWrapper.page-wrapper.compact-wrapper
      include ../../components/header
      // Page Body Start
      .page-body-wrapper
        include ../../components/sidebar
        .page-body
          .container-fluid
            .page-title
              .row
                .col-xl-6.col-sm-6.d-none.d-xl-block
                  include ../../components/sub-header
                .col-xl-6
                  ol.breadcrumb
                    li.breadcrumb-item
                      a(href='index.html')                                        
                        svg.stroke-icon
                          use(href='../assets/svg/icon-sprite.svg#breadcrumb-home')
                    li.breadcrumb-item Maps
                    li.breadcrumb-item.active  Map JS
          // Container-fluid starts
          .container-fluid
            .row
              .col-xl-6
                .card
                  .card-header
                    h4 Map at a specified location
                    p.f-m-light.mt-1 Display a map at a specified location and zoom level.
                  .card-body.z-1
                    #weathermap.map-js-height
              .col-xl-6
                .card
                  .card-header
                    h4 Map using View Bounds
                    p.f-m-light.mt-1 Display a map of a given area.
                  .card-body.z-1
                    #map2.map-js-height 
              
          // Container-fluid Ends
        include ../../components/footer
    include ../../components/footer-files
