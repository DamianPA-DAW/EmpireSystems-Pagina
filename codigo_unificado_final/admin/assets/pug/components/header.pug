// Page Header Start
.page-header
  .header-wrapper.row.g-0
    .logo-wrapper
        a(href='index.html')
          img.img-fluid(src='../assets/images/logo/logo.png', alt='')
    svg.stroke-icon.toggle-sidebar
      use(href='../assets/svg/icon-sprite.svg#stroke-toggle').status_toggle.middle.sidebar-toggle 
    form(action='#', method='get').col-auto.form-inline.search-full
      .form-group.form-inline.search-full.d-none.d-xl-block
        .Typeahead.Typeahead--twitterUsers
          .u-posRelative
            input.demo-input.Typeahead-input.form-control-plaintext(type='text' placeholder='Type to Search ..' name='q' title='' autofocus)
            svg.search-bg.svg-color
              use(href='../assets/svg/icon-sprite.svg#stroke-search')
          .Typeahead-menu
    .nav-right.col-auto.pull-right.right-header.p-0.ms-auto
      ul.nav-menus
        li.serchinput
          .serchbox
            svg.stroke-icon.search-stroke
              use(href='../assets/svg/icon-sprite.svg#searchbox')
          .form-group.search-form
              input(type="text" placeholder="Search here...")
        li
          .mode
            svg
              use(href='../assets/svg/icon-sprite.svg#stroke-dark-light')
        li.onhover-dropdown
           .notification-box
             svg
               use(href='../assets/svg/icon-sprite.svg#stroke-notify')
           .onhover-show-div.notification-dropdown
             h6.f-18.mb-0.dropdown-title Notifications                               
             ul
                li.b-l-primary.border-4.toast.default-show-toast.notification-toast.align-items-center.text-light.border-0.fade.show(aria-live='assertive' aria-atomic='true' data-bs-autohide='false')
                  .d-flex.justify-content-between
                    .toast-body.d-flex.p-0
                      .flex-shrink-0.notification-circle.bg-light-primary
                        svg.stroke-primary.stroke-icon
                            use(href='../assets/svg/icon-sprite.svg#stroke-chat')
                      .flex-grow-1
                        a(href='private-chat.html')
                          h6.m-0 System Reminders 
                        p.m-0  Warnings on faults
                    button.btn-close.btn-close-white.shadow-none.msg-remove(type='button' data-bs-dismiss='toast' aria-label='Close')
                li.b-l-secondary.border-4.toast.default-show-toast.notification-toast.align-items-center.text-light.border-0.fade.show(aria-live='assertive' aria-atomic='true' data-bs-autohide='false')
                  .d-flex.justify-content-between
                    .toast-body.d-flex.p-0
                      .flex-shrink-0.notification-circle.bg-light-secondary
                        svg.stroke-secondary.stroke-icon
                            use(href='../assets/svg/icon-sprite.svg#stroke-task')
                      .flex-grow-1
                        a(href='private-chat.html')
                          h6.m-0 Info Card
                        p.m-0  Important Updates
                    button.btn-close.btn-close-white.msg-remove(type='button' data-bs-dismiss='toast' aria-label='Close')
                li.b-l-warning.border-4.toast.default-show-toast.notification-toast.align-items-center.text-light.border-0.fade.show(aria-live='assertive' aria-atomic='true' data-bs-autohide='false')
                  .d-flex.justify-content-between
                    .toast-body.d-flex.p-0
                      .flex-shrink-0.notification-circle.bg-light-warning
                        svg.stroke-warning.stroke-icon
                            use(href='../assets/svg/icon-sprite.svg#stroke-board')
                      .flex-grow-1
                        a(href='private-chat.html')
                          h6.m-0 Rapid View 
                        p.m-0  Quick information
                    button.btn-close.btn-close-white.msg-remove(type='button' data-bs-dismiss='toast' aria-label='Close')
                li.b-l-success.border-4.toast.default-show-toast.notification-toast.align-items-center.text-light.border-0.fade.show(aria-live='assertive' aria-atomic='true' data-bs-autohide='false')
                  .d-flex.justify-content-between
                    .toast-body.d-flex.p-0
                      .flex-shrink-0.notification-circle.bg-light-success
                        svg.stroke-success.stroke-icon
                            use(href='../assets/svg/icon-sprite.svg#stroke-layout')
                      .flex-grow-1
                        a(href='private-chat.html')
                          h6.m-0 Caution Panel 
                        p.m-0  Immediate cautions
                    button.btn-close.btn-close-white.msg-remove(type='button' data-bs-dismiss='toast' aria-label='Close')
                li.card-body.p-0.empty-card.trash-items
                  .empty-cart-wrapper
                      .empty-cart-content
                          svg
                            use(href='../assets/svg/icon-sprite.svg#empty-messages')
                      h6.text-gray No updates available..
                      a(href="category.html")
        li.onhover-dropdown.bookmark
           svg
             use(href='../assets/svg/icon-sprite.svg#star')
           .onhover-show-div.bookmark-flip
             .flip-card
               .flip-card-inner
                 .front
                   h6.f-18.mb-0.dropdown-title Bookmark
                   ul.bookmark-dropdown
                     li
                       .row
                         .col-4.text-center
                           a(href="form-validation.html")
                             .bookmark-content
                               .bookmark-icon
                                 i(data-feather='file-text')
                               span Forms 
                         .col-4.text-center
                           a(href="user-profile.html")
                             .bookmark-content
                               .bookmark-icon
                                 i(data-feather='user')
                               span Profile 
                         .col-4.text-center
                           a(href="bootstrap-basic-table.html")
                             .bookmark-content
                               .bookmark-icon
                                 i(data-feather='server')
                               span Tables 
                     li.text-center.media-body 
                       a.flip-btn#flip-btn.f-w-700(href="javascript:void(0)") Add New Bookmark
                 .back
                   ul
                     li
                       .bookmark-dropdown.flip-back-content
                         input(type='text' placeholder='search...')
                     li.media-body
                       a.f-w-700.d-block.flip-back#flip-back(href="javascript:void(0)")
                         | Back                   
        li.onhover-dropdown.message-box
           .message.notification-box
             svg
               use(href='../assets/svg/icon-sprite.svg#stroke-messages')
             span.rounded-pill.badge-danger
           .onhover-show-div.message-dropdown
             h6.f-18.mb-0.dropdown-title Message                               
             ul
               li.bg-light-primary.gap-2
                 .d-flex.align-items-start
                   .message-img.bg-light-primary
                     img(src="../assets/images/user/3.jpg" alt="")
                   .flex-grow-1
                     h5.mb-1
                       a.font-primary(href="private-chat.html") Liv Roach
                     p Guess what? I have some exciting news! 
                   .notification-right
                     i.close-icon.stroke-primary(data-feather="x")
               li.bg-light-secondary.gap-2
                 .d-flex.align-items-start
                   .message-img.bg-light-primary
                     img(src="../assets/images/user/6.jpg" alt="")
                   .flex-grow-1
                     h5.mb-1
                       a.font-secondary(href="private-chat.html") Jason Borne
                     p Good morning! I hope you have an amazing day. 
                   .notification-right
                     i.close-icon.stroke-secondary(data-feather="x")
               li.bg-light-success.gap-2
                 .d-flex.align-items-start
                   .message-img.bg-light-primary
                     img(src="../assets/images/user/10.jpg" alt="")
                   .flex-grow-1
                     h5.mb-1
                       a.font-success(href="private-chat.html") Sarah Loren
                     p Soon, let's have a movie night! 
                   .notification-right
                     i.close-icon.stroke-success(data-feather="x")
               li.no-messages.text-center(style="display: none;")
                  svg
                    use(href='../assets/svg/icon-sprite.svg#empty-sms')
                  p No messages to show. 
               li.text-center
                 a.btn.bg-primary.f-w-700(href="mail-box.html") Check all
        li.cart-nav.onhover-dropdown
           .cart-box
             svg
               use(href='../assets/svg/icon-sprite.svg#cart')
           .cart-dropdown.onhover-show-div
             h6.f-18.mb-0.dropdown-title Cart
             ul
                li.cart-list
                  .d-flex
                    img.img-fluid.b-r-5.me-3.img-60(src='../assets/images/other-images/cart-img.jpg', alt='')
                    .flex-grow-1
                      a(href="../template/product-grid.html") Furniture Chair for Home
                      .touchspin-wrapper 
                        button.decrement-touchspin.btn-touchspin.touchspin-primary
                          i.fa-solid.fa-minus 
                        input.input-touchspin.spin-outline-primary(type='number' value='2')
                        button.increment-touchspin.btn-touchspin.touchspin-primary
                          i.fa-solid.fa-plus

                      h6.font-primary $12.45
                    .close-circle
                      a.bg-danger(href='#')
                        i(data-feather='x')
                li.cart-list
                  .d-flex
                    img.img-fluid.b-r-5.me-3.img-60(src='../assets/images/other-images/cart-img1.jpg', alt='')
                    .flex-grow-1
                      a(href="../template/product-grid.html") Rest Well Chair
                      .touchspin-wrapper 
                        button.decrement-touchspin.btn-touchspin.touchspin-primary
                          i.fa-solid.fa-minus 
                        input.input-touchspin.spin-outline-primary(type='number' value='1')
                        button.increment-touchspin.btn-touchspin.touchspin-primary
                          i.fa-solid.fa-plus

                      h6.font-primary $49.00
                    .close-circle
                      a.bg-danger(href='#')
                        i(data-feather='x')
                li.empty-msgs.cart-bag(style="display: none;")
                  img(src="../assets/images/gif/empty-cart.gif" alt="empty-cart")
                li.total
                  h6.mb-0
                    | Order Total : 
                    span.f-right $1000.00
                li.text-center
                  a.d-block.view-cart.f-w-700.btn.btn-primary.w-100(href='cart.html')
                    | View Cart
                  a.btn.btn-primary.view-checkout.btn.btn-primary.w-100.f-w-700(href='checkout.html')
                    | Checkout
        li.language-nav
           .translate_wrapper
             .current_lang
               .lang.stroke-lang
                 i.flag-icon.flag-icon-us
                 span.lang-txt EN
                 svg
                   use(href='../assets/svg/icon-sprite.svg#arrow')                                
             .more_lang
               .lang.selected(data-value='en')
                 i.flag-icon.flag-icon-us
                 span.lang-txt
                   | English
                   span  (US)
               .lang(data-value='de')
                 i.flag-icon.flag-icon-de
                 span.lang-txt Deutsch
               .lang(data-value='es')
                 i.flag-icon.flag-icon-es
                 span.lang-txt Español
               .lang(data-value='fr')
                 i.flag-icon.flag-icon-fr
                 span.lang-txt Français
               .lang(data-value='pt')
                 i.flag-icon.flag-icon-pt
                 span.lang-txt
                   | Português
                   span  (BR)
               .lang(data-value='cn')
                 i.flag-icon.flag-icon-cn
                 span.lang-txt 简体中文
               .lang(data-value='ae')
                 i.flag-icon.flag-icon-ae
                 span.lang-txt
                   | لعربية 
                   span  (ae)
        li.profile-nav.onhover-dropdown.pe-0.py-0
           .d-flex.profile-media
             img.img-fluid.rounded-circle(src='../assets/images/dashboard/profile.png', alt='')
             .flex-grow-1
               span Atlas Grey
               p.mb-0.profile-arrow Admin 
                 svg
                   use(href='../assets/svg/icon-sprite.svg#arrow')
           ul.profile-dropdown.onhover-show-div
              li
                a(href='sign-up.html')
                  i(data-feather='user')
                  span Account 
              li
                a(href='mail-box.html')
                  i(data-feather='mail')
                  span Inbox
              li
                a(href='task.html')
                  i(data-feather='file-text')
                  span Taskboard
              li
                a(href='add-user.html')
                  i(data-feather='settings')
                  span Settings
              li
                a(href='login.html')
                  i(data-feather='log-in') 
                  span Log out

    //- .d-lg-none.mobile-toggle.pull-right
    //-     i(data-feather='more-horizontal')
    script.result-template(type='text/x-handlebars-template').
      <div class="ProfileCard u-cf">                        
      <div class="ProfileCard-avatar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-airplay m-0"><path d="M5 17H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-1"></path><polygon points="12 15 17 21 7 21 12 15"></polygon></svg></div>
      <div class="ProfileCard-details">
      <div class="ProfileCard-realName">{{name}}</div>
      </div>
      </div>
    script.empty-template(type='text/x-handlebars-template').
      <div class="EmptyMessage">Your search turned up 0 results. This most likely means the backend is down, yikes!</div>
// Page Header Ends                              
