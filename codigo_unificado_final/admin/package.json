{
  "name": "vite-pug-scss-project",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "api": "node api/server.js",
    "dev:api": "node api/server.js",
    "dev:vite": "vite",
    "dev:scss": "sass assets/scss:assets/css --no-source-map --watch",
    "dev:pug": "npx pug assets/pug/pages/template/**.pug --pretty --out template --watch"
    
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "pug-cli": "^1.0.0-alpha6",
    "sass": "1.77.6",
    "vite": "^4.0.0"
  }
}
